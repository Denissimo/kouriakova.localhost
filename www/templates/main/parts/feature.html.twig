<!--Feature One Start-->
<section class="feature-one">
    <div class="container" id="features_list">
        <div class="row">
            {% set article_counter = 0 %}
            {% for article in articles  %}
                {% set article_counter = article_counter + 1 %}
                <div class="col-xl-4 col-lg-4 wow fadeInUp" data-wow-delay="{{ article_counter }}00ms">
                    <div class="feature-one__single">
                        <div class="feature-one-single-bg"
                             style="background-image: url(/assets/images/backgrounds/feature-one-single-bg.jpg);">
                        </div>
                        <div class="feature-one__icon">
                            <img src="{{ article.image }}" alt="">
                            <div class="feature-one__icon-shape">
                                <img src="/assets/images/shapes/feature-one-icon-shape.png" alt="">
                            </div>
                        </div>
                        <div class="feature-one__title-box">
                            <div class="feature-one__title-border"></div>
                            <h3 class="feature-one__title"><a href="{{ article.path }}">{{ article.title }}</a></h3>
                        </div>
                        <p class="feature-one__text">{{ article.annotation|raw }}</p>
                        <div class="feature-one__btn-box">
                            <a href="/psychology/{{ article.path }}" class="feature-one__btn">Подробнее</a>
                        </div>
                    </div>
                </div>
{#                <li>{{ team.name }} - {{ team.championship }} - {{ team.budget|number_format(2, '.', ',') }}£</li>#}
            {% endfor  %}
            </div>
    </div>
</section>
<!--Feature One End-->